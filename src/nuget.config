<?xml version="1.0" encoding="utf-8"?>
<!-- Package sources for the .NET solution. Only nuget.org, and only the
     packages listed below may come from it, so a new dependency is a
     visible change here. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <!-- xUnit and the test platform. -->
      <package pattern="xunit" />
      <package pattern="xunit.*" />
      <package pattern="Microsoft.NET.Test.Sdk" />
      <package pattern="Microsoft.TestPlatform.*" />
      <package pattern="Microsoft.CodeCoverage" />
      <package pattern="Newtonsoft.Json" />
      <!-- The PowerShell SDK the window hosts, and what it depends on. -->
      <package pattern="Microsoft.PowerShell.SDK" />
      <package pattern="Humanizer.Core" />
      <package pattern="Json.More.Net" />
      <package pattern="JsonPointer.Net" />
      <package pattern="JsonSchema.Net" />
      <package pattern="Markdig.Signed" />
      <package pattern="Microsoft.ApplicationInsights" />
      <package pattern="Microsoft.Bcl.AsyncInterfaces" />
      <package pattern="Microsoft.CodeAnalysis.Analyzers" />
      <package pattern="Microsoft.CodeAnalysis.Common" />
      <package pattern="Microsoft.CodeAnalysis.CSharp" />
      <package pattern="Microsoft.Extensions.ObjectPool" />
      <package pattern="Microsoft.Management.Infrastructure.CimCmdlets" />
      <package pattern="Microsoft.Management.Infrastructure.Runtime.Unix" />
      <package pattern="Microsoft.Management.Infrastructure.Runtime.Win" />
      <package pattern="Microsoft.Management.Infrastructure" />
      <package pattern="Microsoft.PowerShell.Commands.Diagnostics" />
      <package pattern="Microsoft.PowerShell.Commands.Management" />
      <package pattern="Microsoft.PowerShell.Commands.Utility" />
      <package pattern="Microsoft.PowerShell.ConsoleHost" />
      <package pattern="Microsoft.PowerShell.CoreCLR.Eventing" />
      <package pattern="Microsoft.PowerShell.MarkdownRender" />
      <package pattern="Microsoft.PowerShell.Native" />
      <package pattern="Microsoft.PowerShell.Security" />
      <package pattern="Microsoft.Security.Extensions" />
      <package pattern="Microsoft.Win32.Registry.AccessControl" />
      <package pattern="Microsoft.Win32.SystemEvents" />
      <package pattern="Microsoft.Windows.Compatibility" />
      <package pattern="Microsoft.WSMan.Management" />
      <package pattern="Microsoft.WSMan.Runtime" />
      <package pattern="runtime.android-arm.runtime.native.System.IO.Ports" />
      <package pattern="runtime.android-arm64.runtime.native.System.IO.Ports" />
      <package pattern="runtime.android-x64.runtime.native.System.IO.Ports" />
      <package pattern="runtime.android-x86.runtime.native.System.IO.Ports" />
      <package pattern="runtime.linux-arm.runtime.native.System.IO.Ports" />
      <package pattern="runtime.linux-arm64.runtime.native.System.IO.Ports" />
      <package pattern="runtime.linux-bionic-arm64.runtime.native.System.IO.Ports" />
      <package pattern="runtime.linux-bionic-x64.runtime.native.System.IO.Ports" />
      <package pattern="runtime.linux-musl-arm.runtime.native.System.IO.Ports" />
      <package pattern="runtime.linux-musl-arm64.runtime.native.System.IO.Ports" />
      <package pattern="runtime.linux-musl-x64.runtime.native.System.IO.Ports" />
      <package pattern="runtime.linux-x64.runtime.native.System.IO.Ports" />
      <package pattern="runtime.maccatalyst-arm64.runtime.native.System.IO.Ports" />
      <package pattern="runtime.maccatalyst-x64.runtime.native.System.IO.Ports" />
      <package pattern="runtime.native.System.Data.SqlClient.sni" />
      <package pattern="runtime.native.System.IO.Ports" />
      <package pattern="runtime.osx-arm64.runtime.native.System.IO.Ports" />
      <package pattern="runtime.osx-x64.runtime.native.System.IO.Ports" />
      <package pattern="runtime.win-arm64.runtime.native.System.Data.SqlClient.sni" />
      <package pattern="runtime.win-x64.runtime.native.System.Data.SqlClient.sni" />
      <package pattern="runtime.win-x86.runtime.native.System.Data.SqlClient.sni" />
      <package pattern="System.CodeDom" />
      <package pattern="System.ComponentModel.Composition.Registration" />
      <package pattern="System.ComponentModel.Composition" />
      <package pattern="System.Configuration.ConfigurationManager" />
      <package pattern="System.Data.Odbc" />
      <package pattern="System.Data.OleDb" />
      <package pattern="System.Data.SqlClient" />
      <package pattern="System.Diagnostics.EventLog" />
      <package pattern="System.Diagnostics.PerformanceCounter" />
      <package pattern="System.DirectoryServices.AccountManagement" />
      <package pattern="System.DirectoryServices.Protocols" />
      <package pattern="System.DirectoryServices" />
      <package pattern="System.Drawing.Common" />
      <package pattern="System.IO.Packaging" />
      <package pattern="System.IO.Ports" />
      <package pattern="System.Management.Automation" />
      <package pattern="System.Management" />
      <package pattern="System.Net.Http.WinHttpHandler" />
      <package pattern="System.Reflection.Context" />
      <package pattern="System.Runtime.Caching" />
      <package pattern="System.Security.Cryptography.Pkcs" />
      <package pattern="System.Security.Cryptography.ProtectedData" />
      <package pattern="System.Security.Cryptography.Xml" />
      <package pattern="System.Security.Permissions" />
      <package pattern="System.ServiceModel.Http" />
      <package pattern="System.ServiceModel.NetFramingBase" />
      <package pattern="System.ServiceModel.NetTcp" />
      <package pattern="System.ServiceModel.Primitives" />
      <package pattern="System.ServiceModel.Syndication" />
      <package pattern="System.ServiceProcess.ServiceController" />
      <package pattern="System.Speech" />
      <package pattern="System.Web.Services.Description" />
      <package pattern="System.Windows.Extensions" />
    </packageSource>
  </packageSourceMapping>
</configuration>
