<?xml version="1.0" encoding="utf-8"?>
<!-- Package sources for the .NET solution. Only nuget.org, and only the
     packages listed below may come from it, so a new dependency is a
     visible change here. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <!-- xUnit and the test platform. -->
      <package pattern="xunit" />
      <package pattern="xunit.*" />
      <package pattern="Microsoft.NET.Test.Sdk" />
      <package pattern="Microsoft.TestPlatform.*" />
      <package pattern="Microsoft.CodeCoverage" />
      <package pattern="Newtonsoft.Json" />
    </packageSource>
  </packageSourceMapping>
</configuration>
