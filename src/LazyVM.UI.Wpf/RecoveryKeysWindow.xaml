<Window x:Class="LazyVM.UI.Wpf.RecoveryKeysWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LazyVM.UI.Wpf"
        xmlns:vm="clr-namespace:LazyVM.UI.ViewModels;assembly=LazyVM.UI"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:RecoveryKeysViewModel}"
        Title="{Binding Title}" Width="760" Height="640" MinWidth="320"
        Style="{StaticResource LvWindow}">
    <Window.CommandBindings>
        <CommandBinding Command="Close" Executed="CloseWindow" />
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="Close" />
    </Window.InputBindings>

    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource LvHeaderBar}">
            <TextBlock Text="{Binding Name, StringFormat='Recovery keys of {0}'}" Style="{StaticResource LvTitle}" />
        </Border>

        <!-- Exporting. With no key stored, Export is disabled and the note says why. Each warning the module gives is text of its own, so Narrator reads it. -->
        <StackPanel DockPanel.Dock="Bottom" Margin="24,0,24,24">
            <!-- What Export does and where to keep the file. The button's help text is the same, so Narrator reads it too. -->
            <TextBlock Text="{Binding ExportHelp}" Style="{StaticResource LvMuted}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <WrapPanel>
                <Button Content="_Export..." Command="{Binding ExportCommand}" Margin="0,0,8,8"
                        AutomationProperties.Name="{Binding Name, StringFormat='Export the recovery keys of {0}'}"
                        AutomationProperties.HelpText="{Binding ExportHelp}" />
            </WrapPanel>
            <TextBlock Text="{Binding ExportNote}" TextWrapping="Wrap"
                       Visibility="{Binding HasExportNote, Converter={StaticResource VisibleWhenTrue}}"
                       AutomationProperties.Name="{Binding ExportNote}" />
            <ItemsControl ItemsSource="{Binding Warnings}" Focusable="False"
                          Visibility="{Binding HasWarnings, Converter={StaticResource VisibleWhenTrue}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource LvAttentionBadge}" Margin="0,8,0,0" HorizontalAlignment="Stretch">
                            <TextBlock Text="{Binding StringFormat='Warning: {0}'}" TextWrapping="Wrap" Focusable="True" Foreground="{DynamicResource LvOnSev}"
                                       AutomationProperties.Name="{Binding StringFormat='Warning: {0}'}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding Status}" Style="{StaticResource LvStatus}" Margin="0,8,0,0"
                       Visibility="{Binding HasStatus, Converter={StaticResource VisibleWhenTrue}}"
                       AutomationProperties.Name="{Binding Status}" local:LiveRegion.Announce="True" />
            <ProgressBar Style="{StaticResource LvWorkingBar}" />
        </StackPanel>

        <Border Style="{StaticResource LvPanel}" Margin="24">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Style="{StaticResource LvMuted}" Margin="0,0,0,8"
                           Text="When BitLocker asks for a recovery key, it shows the start of a key ID. Each password is hidden until you choose Show; closing this window hides them all." />
                <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,0,0,8"
                           AutomationProperties.Name="{Binding Summary}" />
                <!-- A list, so the arrow keys move through the disks and Narrator reads each one; Tab reaches each disk's Show button. -->
                <ListBox x:Name="List" ItemsSource="{Binding Keys}"
                         AutomationProperties.Name="Recovery keys"
                         KeyboardNavigation.TabNavigation="Continue"
                         BorderThickness="1" BorderBrush="{DynamicResource LvCardBorder}"
                         Background="{DynamicResource LvCard}" Foreground="{DynamicResource LvInk}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource LvListItem}">
                            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:RecoveryKeyRow">
                            <StackPanel Margin="0,4">
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                <DockPanel Margin="0,4,0,0">
                                    <Button DockPanel.Dock="Left" Content="{Binding ToggleText}" Command="{Binding ToggleCommand}" MinWidth="72" Margin="0,0,12,0"
                                            AutomationProperties.Name="{Binding ToggleName}" />
                                    <!-- Read-only text, so Narrator can read the password a character at a time once shown. It cannot be copied or
                                         dragged out: the ordinary clipboard keeps it in its history and syncs it, and nothing would clear it. -->
                                    <TextBox Text="{Binding PasswordText, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                             DataObject.Copying="BlockCopy" ContextMenuService.IsEnabled="False"
                                             Foreground="{DynamicResource LvInk}" FontFamily="Consolas" VerticalAlignment="Center" TextWrapping="Wrap"
                                             AutomationProperties.Name="{Binding PasswordName}" />
                                </DockPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </DockPanel>
</Window>
