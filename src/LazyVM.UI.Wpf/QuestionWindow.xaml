<Window x:Class="LazyVM.UI.Wpf.QuestionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LazyVM.UI.ViewModels;assembly=LazyVM.UI"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:QuestionViewModel}"
        Title="{Binding Title}" MinWidth="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        Style="{StaticResource LvPopUp}">
    <!-- No is both the default and the cancel button, and has focus: Enter and Esc both answer No. Only Yes, by click, Alt+Y or Space on it, goes ahead. -->
    <!-- In a window smaller than its content the page scrolls (#558). -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <StackPanel Margin="24">
        <TextBlock Text="{Binding Question}" TextWrapping="Wrap" Margin="0,0,0,16" />
        <WrapPanel HorizontalAlignment="Right">
            <Button Content="_Yes" Click="AnswerYes" MinWidth="88" Margin="0,0,8,0"
                    AutomationProperties.HelpText="{Binding Question}" />
            <Button x:Name="NoButton" Content="_No" IsDefault="True" IsCancel="True" MinWidth="88"
                    AutomationProperties.HelpText="{Binding Question}" />
        </WrapPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
