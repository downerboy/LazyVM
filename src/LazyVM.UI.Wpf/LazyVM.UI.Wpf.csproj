<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- Hosts PowerShell in the app to run the module's commands. The 7.6
         line is the one the module supports (PowerShell 7.6 minimum). -->
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.6.10" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LazyVM.UI.Wpf.Tests" />
  </ItemGroup>

</Project>
