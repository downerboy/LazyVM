<Window x:Class="LazyVM.UI.Wpf.ChecksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LazyVM.UI.Wpf"
        xmlns:vm="clr-namespace:LazyVM.UI.ViewModels;assembly=LazyVM.UI"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ChecksViewModel}"
        Title="{Binding Title}" Width="860" Height="760" MinWidth="320"
        Style="{StaticResource LvWindow}">
    <Window.CommandBindings>
        <CommandBinding Command="Close" Executed="CloseWindow" />
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="Close" />
        <KeyBinding Key="F5" Command="{Binding RunCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource LvHeaderBar}">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Content="Check again" Command="{Binding RunCommand}"
                            AutomationProperties.Name="Check again (F5)" />
                    <Button Content="Cancel checks" Command="{Binding CancelCommand}" Margin="8,0,0,0"
                            Visibility="{Binding IsRunning, Converter={StaticResource VisibleWhenTrue}}" />
                </WrapPanel>
                <TextBlock Text="{Binding Heading}" Style="{StaticResource LvTitle}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource LvPanel}" Margin="24,0,24,24" Padding="24,16">
            <StackPanel>
                <TextBlock Text="Result" Style="{StaticResource LvHeading}" />
                <TextBlock Text="{Binding Status}" Style="{StaticResource LvStatus}"
                           AutomationProperties.Name="{Binding Status}" local:LiveRegion.Announce="True" />
                <ProgressBar Style="{StaticResource LvWorkingBar}" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource LvPanel}" Margin="24">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Checks" Style="{StaticResource LvHeading}" />
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource LvMuted}" Margin="0,0,0,12"
                           Text="Nothing is changed. Each problem says how to fix it; Ctrl+C copies the fix." />
                <!-- A list, so the arrow keys move from one check to the next and Narrator reads each one with its fix. -->
                <ListBox x:Name="List" ItemsSource="{Binding Checks}" AutomationProperties.Name="Checks"
                         BorderThickness="0" Background="{DynamicResource LvCard}" Foreground="{DynamicResource LvInk}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.CommandBindings>
                        <CommandBinding Command="Copy" Executed="CopyFix" />
                    </ListBox.CommandBindings>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource LvListItem}">
                            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                            <Setter Property="Padding" Value="8,10" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:CheckRowViewModel">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- The status as a shape and a word, never color alone; a warning or failure on the attention color. -->
                                <Border VerticalAlignment="Top" HorizontalAlignment="Left" Padding="8,2" CornerRadius="4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource LvSevMedium}" />
                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource LvOnSev}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontWeight="SemiBold">
                                        <Run Text="{Binding Symbol, Mode=OneWay}" /> <Run Text="{Binding StatusText, Mode=OneWay}" />
                                    </TextBlock>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock TextWrapping="Wrap">
                                        <Run Text="{Binding Check, Mode=OneWay}" FontWeight="Bold" /><Run Text="{Binding Area, Mode=OneWay, StringFormat=' ({0})'}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" />
                                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                                               Visibility="{Binding HasFix, Converter={StaticResource VisibleWhenTrue}}">
                                        <Run Text="Fix:" FontWeight="SemiBold" /> <Run Text="{Binding Fix, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </DockPanel>
</Window>
