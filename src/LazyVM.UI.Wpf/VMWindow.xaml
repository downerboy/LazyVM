<Window x:Class="LazyVM.UI.Wpf.VMWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LazyVM.UI.Wpf"
        xmlns:vm="clr-namespace:LazyVM.UI.Wpf.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:VMViewModel}"
        Title="{Binding Title}" Width="760" Height="900" MinWidth="320"
        Style="{StaticResource LvWindow}">
    <Window.CommandBindings>
        <CommandBinding Command="Close" Executed="CloseWindow" />
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="Close" />
    </Window.InputBindings>

    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource LvHeaderBar}">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Content="Checks" Command="{Binding ChecksCommand}"
                            AutomationProperties.Name="{Binding Name, StringFormat='Checks of {0}'}" />
                    <Button Content="Log" Command="{Binding LogCommand}" Margin="8,0,0,0"
                            AutomationProperties.Name="{Binding Name, StringFormat='Log of {0}'}" />
                    <Button Content="_Restore..." Command="{Binding RestorePointsCommand}" Margin="8,0,0,0"
                            AutomationProperties.Name="{Binding Name, StringFormat='Restore points of {0}'}"
                            AutomationProperties.HelpText="Lists the VM's restore points, to return it to one." />
                    <Button Content="Pass_word..." Command="{Binding PasswordCommand}" Margin="8,0,0,0"
                            AutomationProperties.Name="{Binding Name, StringFormat='Password of {0}'}"
                            AutomationProperties.HelpText="Shows the account LazyVM signs in to the VM with. The password stays hidden until you ask for it." />
                    <Button Content="_Security findings..." Command="{Binding SecurityFindingsCommand}" Margin="8,0,0,0"
                            AutomationProperties.Name="{Binding Name, StringFormat='Security findings of {0}'}"
                            AutomationProperties.HelpText="Lists what the VM's last nightly security scan found, and the findings approved." />
                    <Button Content="Build progress" Command="{Binding BuildProgressCommand}" Margin="8,0,0,0"
                            Visibility="{Binding IsBuilding, Converter={StaticResource VisibleWhenTrue}}"
                            AutomationProperties.Name="{Binding Name, StringFormat='Progress of the build of {0}'}" />
                </WrapPanel>
                <StackPanel>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource LvTitle}" />
                    <TextBlock Text="{Binding State}" Style="{StaticResource LvSubtitle}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Starting a build or maintenance. While a run of the VM is going, both buttons are disabled and the note says why. -->
        <Border DockPanel.Dock="Top" Style="{StaticResource LvPanel}" Margin="24,24,24,0">
            <StackPanel>
                <TextBlock Text="Build and maintain" Style="{StaticResource LvHeading}" Margin="0,0,0,12" />
                <Label Content="_Phase to build from" Target="{Binding ElementName=PhaseList}" Padding="0" Foreground="{DynamicResource LvInk}" FontWeight="SemiBold" />
                <!-- What building from the chosen phase skips, runs again and keeps. The list's help text is the same, so Narrator reads it too. -->
                <TextBlock Text="{Binding PhaseHelp}" Style="{StaticResource LvMuted}" TextWrapping="Wrap"
                           Visibility="{Binding HasPhaseHelp, Converter={StaticResource VisibleWhenTrue}}" />
                <!-- A list rather than a drop-down, as in the Build window, so the arrow keys move through the phases and Narrator reads each one. -->
                <ListBox x:Name="PhaseList" ItemsSource="{Binding Phases}" SelectedItem="{Binding SelectedPhase}"
                         DisplayMemberPath="Text" Margin="0,4,0,8" MaxHeight="190"
                         AutomationProperties.Name="Phase to build from"
                         AutomationProperties.HelpText="{Binding PhaseHelp}"
                         BorderThickness="1" BorderBrush="{DynamicResource LvCardBorder}"
                         Background="{DynamicResource LvCard}" Foreground="{DynamicResource LvInk}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource LvListItem}">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Text}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
                <WrapPanel>
                    <Button Content="_Build from this phase" Command="{Binding BuildFromPhaseCommand}" Margin="0,0,8,8"
                            AutomationProperties.Name="{Binding Name, StringFormat='Build {0} from the chosen phase'}"
                            AutomationProperties.HelpText="Starts the build in its own process, and shows its progress. Closing the app does not stop it." />
                    <Button Content="Run _maintenance now" Command="{Binding MaintenanceCommand}" Margin="0,0,8,8"
                            AutomationProperties.Name="{Binding Name, StringFormat='Run the maintenance of {0} now'}"
                            AutomationProperties.HelpText="{Binding MaintenanceHelp}" />
                </WrapPanel>
                <!-- What Run maintenance now does. The button's help text is the same, so Narrator reads it too. -->
                <TextBlock Text="{Binding MaintenanceHelp}" Style="{StaticResource LvMuted}" TextWrapping="Wrap" Margin="0,0,0,8" />
                <TextBlock Text="{Binding RunNote}" TextWrapping="Wrap"
                           Visibility="{Binding HasRunNote, Converter={StaticResource VisibleWhenTrue}}"
                           AutomationProperties.Name="{Binding RunNote}" local:LiveRegion.Announce="True" />
            </StackPanel>
        </Border>

        <!-- Deleting the VM. The dialog it opens lists what goes and asks first. While a run of the VM is going, the button is disabled and the note says why. -->
        <Border DockPanel.Dock="Top" Style="{StaticResource LvPanel}" Margin="24,24,24,0">
            <StackPanel>
                <TextBlock Text="Delete" Style="{StaticResource LvHeading}" Margin="0,0,0,12" />
                <TextBlock Text="Deletes the VM, its disks, its tasks and everything else LazyVM made for it. A list of what goes comes first, and you are asked before anything is deleted."
                           Style="{StaticResource LvMuted}" TextWrapping="Wrap" />
                <WrapPanel Margin="0,8,0,0">
                    <Button Content="_Delete this VM..." Command="{Binding DeleteCommand}" Margin="0,0,8,8"
                            AutomationProperties.Name="{Binding Name, StringFormat='Delete {0}'}"
                            AutomationProperties.HelpText="Lists what deleting the VM deletes, and asks before deleting anything." />
                </WrapPanel>
                <TextBlock Text="{Binding DeleteNote}" TextWrapping="Wrap"
                           Visibility="{Binding HasDeleteNote, Converter={StaticResource VisibleWhenTrue}}"
                           AutomationProperties.Name="{Binding DeleteNote}" />
            </StackPanel>
        </Border>

        <!-- The BitLocker recovery keys: a notice when some are not exported yet, with the button that opens them beside it. -->
        <Border DockPanel.Dock="Top" Style="{StaticResource LvPanel}" Margin="24,24,24,0">
            <StackPanel>
                <TextBlock Text="Recovery keys" Style="{StaticResource LvHeading}" Margin="0,0,0,12" />
                <Border Style="{StaticResource LvAttentionBadge}" Margin="0,0,0,8"
                        Visibility="{Binding HasRecoveryKeyNotice, Converter={StaticResource VisibleWhenTrue}}">
                    <TextBlock Foreground="{DynamicResource LvOnSev}" TextWrapping="Wrap" Focusable="True"
                               AutomationProperties.Name="{Binding RecoveryKeyNotice}">
                        <Run Text="&#x25C6;" /> <Run Text="{Binding RecoveryKeyNotice, Mode=OneWay}" />
                    </TextBlock>
                </Border>
                <TextBlock Text="The BitLocker recovery password of each disk LazyVM encrypted. Shows one when you ask, and exports them to a file you keep offline."
                           Style="{StaticResource LvMuted}" TextWrapping="Wrap" />
                <WrapPanel Margin="0,8,0,0">
                    <Button Content="Recovery _keys..." Command="{Binding RecoveryKeysCommand}" Margin="0,0,8,0"
                            AutomationProperties.Name="{Binding Name, StringFormat='Recovery keys of {0}'}"
                            AutomationProperties.HelpText="Lists the VM's BitLocker recovery keys, to see one or export them to a file." />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- What happened when a build, maintenance or delete was asked for. -->
        <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" Style="{StaticResource LvStatus}" Margin="24,12,24,0"
                   Visibility="{Binding HasStatus, Converter={StaticResource VisibleWhenTrue}}"
                   AutomationProperties.Name="{Binding Status}" local:LiveRegion.Announce="True" />
        <ProgressBar DockPanel.Dock="Top" Style="{StaticResource LvWorkingBar}" Margin="24,8,24,0" />

        <Border Style="{StaticResource LvPanel}" Margin="24">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Details" Style="{StaticResource LvHeading}" Margin="0,0,0,12" />
                <!-- A list, so the arrow keys move from one detail to the next and Narrator reads each one. -->
                <ListBox ItemsSource="{Binding Details}" AutomationProperties.Name="Details"
                         Grid.IsSharedSizeScope="True" BorderThickness="0"
                         Background="{DynamicResource LvCard}" Foreground="{DynamicResource LvInk}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource LvListItem}">
                            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:VMDetail">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Margin="0,0,12,0" TextWrapping="Wrap" />
                                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </DockPanel>
</Window>
