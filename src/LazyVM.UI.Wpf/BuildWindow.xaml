<Window x:Class="LazyVM.UI.Wpf.BuildWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LazyVM.UI.Wpf"
        xmlns:vm="clr-namespace:LazyVM.UI.ViewModels;assembly=LazyVM.UI"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:BuildViewModel}"
        Title="{Binding Title}" Width="640" Height="720" MinWidth="320"
        Style="{StaticResource LvWindow}">
    <Window.CommandBindings>
        <CommandBinding Command="Close" Executed="CloseWindow" />
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="Close" />
    </Window.InputBindings>

    <!-- In a window smaller than its content the page scrolls instead of squeezing the list out of sight (#558).
         There are only a few templates, so the list keeps a height of its own and the page grows around it. -->
    <ScrollViewer x:Name="Page" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <DockPanel MinHeight="{Binding ViewportHeight, ElementName=Page}">
        <Border DockPanel.Dock="Top" Style="{StaticResource LvHeaderBar}">
            <TextBlock Text="Build new VM" Style="{StaticResource LvTitle}" VerticalAlignment="Center" />
        </Border>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource LvPanel}" Margin="24,0,24,24" Padding="24,16">
            <DockPanel>
                <!-- Before a build starts: it runs on its own, so its window can be closed and opened again (#498). -->
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource LvMuted}" TextWrapping="Wrap" Margin="0,0,0,12"
                           Text="The build runs on its own, in its own process. Its progress opens in a window you can close at any time without stopping it: to see it again, select the VM in the list and choose Build progress." />
                <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Content="_Build" Command="{Binding BuildCommand}" IsDefault="True"
                            AutomationProperties.Name="Build the VM" />
                    <Button Content="Close" Command="Close" Margin="8,0,0,0" />
                </WrapPanel>
                <ProgressBar DockPanel.Dock="Bottom" Style="{StaticResource LvWorkingBar}" />
                <TextBlock Text="{Binding Status}" Style="{StaticResource LvStatus}" VerticalAlignment="Center" Margin="0,0,16,0"
                           AutomationProperties.Name="{Binding Status}" local:LiveRegion.Announce="True" />
            </DockPanel>
        </Border>

        <Border Style="{StaticResource LvPanel}" Margin="24">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <Label Content="_Name of the new VM" Target="{Binding ElementName=NameBox}" Padding="0" Foreground="{DynamicResource LvInk}" FontWeight="SemiBold" />
                    <TextBlock Text="1 to 15 letters, digits or hyphens, starting with a letter or digit." Style="{StaticResource LvMuted}" />
                    <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="15" Margin="0,4,0,16"
                             AutomationProperties.Name="Name of the new VM"
                             AutomationProperties.HelpText="1 to 15 letters, digits or hyphens, starting with a letter or digit." />

                    <Label Content="Administrator _account inside the VM (optional)" Target="{Binding ElementName=UserNameBox}" Padding="0" Foreground="{DynamicResource LvInk}" FontWeight="SemiBold" />
                    <TextBlock Text="Leave empty for the usual account. Its password is made for you." Style="{StaticResource LvMuted}" TextWrapping="Wrap" />
                    <TextBox x:Name="UserNameBox" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" Margin="0,4,0,16"
                             AutomationProperties.Name="Administrator account inside the VM, optional"
                             AutomationProperties.HelpText="Leave empty for the usual account. Its password is made for you." />

                    <Label Content="_Config template" Target="{Binding ElementName=TemplateList}" Padding="0" Foreground="{DynamicResource LvInk}" FontWeight="SemiBold" />
                    <TextBlock Text="What the VM is built with. Developer has the developer tools; PlainWindows has Windows alone." Style="{StaticResource LvMuted}" TextWrapping="Wrap" Margin="0,0,0,4" />
                </StackPanel>
                <!-- A list rather than a drop-down, so the arrow keys move through the templates and Narrator reads each one. -->
                <ListBox x:Name="TemplateList" ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}"
                         TextSearch.TextPath="Text" AutomationProperties.Name="Config template"
                         MinHeight="150" BorderThickness="1" BorderBrush="{DynamicResource LvCardBorder}"
                         Background="{DynamicResource LvCard}" Foreground="{DynamicResource LvInk}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource LvListItem}">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Text}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:TemplateOption">
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </DockPanel>
    </ScrollViewer>
</Window>
