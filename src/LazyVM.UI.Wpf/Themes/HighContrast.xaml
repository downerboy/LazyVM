<!-- High Contrast: the same tokens, made from the Windows system colors, so the custom colors drop out. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="LvNavy" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="LvInk" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="LvInkMuted" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="LvPage" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="LvCard" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="LvCardBorder" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="LvTint" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="LvAccent" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="LvAccentHover" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="LvOnAccent" Color="{x:Static SystemColors.ControlTextColor}" />
    <SolidColorBrush x:Key="LvSevMedium" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="LvOnSev" Color="{x:Static SystemColors.HighlightTextColor}" />
    <SolidColorBrush x:Key="LvHeader" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="LvOnHeader" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="LvOnHeaderMuted" Color="{x:Static SystemColors.WindowTextColor}" />
</ResourceDictionary>
