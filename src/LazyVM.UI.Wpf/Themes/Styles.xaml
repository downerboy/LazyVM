<!--
  The brand's styles (docs/Brand.md, docs/Dashboard.md section 6). Colors are
  DynamicResource, because App picks the light, dark or High Contrast tokens
  when it starts.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="LvFont">Segoe UI</FontFamily>

    <Style x:Key="LvWindow" TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource LvPage}" />
        <Setter Property="Foreground" Value="{DynamicResource LvInk}" />
        <Setter Property="FontFamily" Value="{StaticResource LvFont}" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <!-- 3px focus outline, 2px outside the control: navy, yellow in the dark theme. Never removed. -->
    <Style x:Key="LvFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-5" Stroke="{DynamicResource LvFocus}" StrokeThickness="3" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- One button style: yellow, 2px navy border, at least 44 by 44. -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource LvAccent}" />
        <Setter Property="Foreground" Value="{DynamicResource LvOnAccent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LvNavy}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource LvFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Frame"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource LvAccentHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource LvAccentHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Frame" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LvPanel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource LvCard}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LvCardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="24" />
    </Style>

    <Style x:Key="LvHeaderBar" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource LvHeader}" />
        <Setter Property="Padding" Value="24,16" />
    </Style>

    <Style x:Key="LvTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource LvOnHeader}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level1" />
    </Style>

    <Style x:Key="LvSubtitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource LvOnHeaderMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="LvHeading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
    </Style>

    <Style x:Key="LvMuted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource LvInkMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- "Needs attention": the medium-severity diamond and words, never color alone. -->
    <Style x:Key="LvAttentionBadge" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource LvSevMedium}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- The status line, read out by screen readers when it changes. -->
    <Style x:Key="LvStatus" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource LvCard}" />
        <Setter Property="Foreground" Value="{DynamicResource LvInk}" />
        <Setter Property="RowBackground" Value="{DynamicResource LvCard}" />
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource LvTint}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LvCardBorder}" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource LvCardBorder}" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource LvCard}" />
        <Setter Property="Foreground" Value="{DynamicResource LvInk}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LvNavy}" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Padding" Value="12" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A text block that hides itself while its text is empty. -->
    <Style x:Key="LvOptionalText" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
