<!-- The brand's color tokens (docs/Brand.md), light theme. Brushes come from these only. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="LvNavy" Color="#0B2E59" />
    <SolidColorBrush x:Key="LvInk" Color="#13223F" />
    <SolidColorBrush x:Key="LvInkMuted" Color="#475467" />
    <SolidColorBrush x:Key="LvPage" Color="#F5F8FC" />
    <SolidColorBrush x:Key="LvCard" Color="#FFFFFF" />
    <SolidColorBrush x:Key="LvCardBorder" Color="#C9D6E5" />
    <SolidColorBrush x:Key="LvTint" Color="#DCEAF8" />
    <SolidColorBrush x:Key="LvAccent" Color="#FFD75E" />
    <SolidColorBrush x:Key="LvAccentHover" Color="#FFC929" />
    <SolidColorBrush x:Key="LvOnAccent" Color="#0B2E59" />
    <SolidColorBrush x:Key="LvSevMedium" Color="#B54708" />
    <SolidColorBrush x:Key="LvOnSev" Color="#FFFFFF" />
    <!-- The header bar: navy, with white text and the light border color under it. -->
    <SolidColorBrush x:Key="LvHeader" Color="#0B2E59" />
    <SolidColorBrush x:Key="LvOnHeader" Color="#FFFFFF" />
    <SolidColorBrush x:Key="LvOnHeaderMuted" Color="#C9D6E5" />
</ResourceDictionary>
