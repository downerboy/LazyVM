<Window x:Class="LazyVM.UI.Wpf.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LazyVM.UI.Wpf"
        xmlns:vm="clr-namespace:LazyVM.UI.ViewModels;assembly=LazyVM.UI"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:PasswordViewModel}"
        Title="{Binding Title}" Width="620" SizeToContent="Height" MinWidth="320"
        Style="{StaticResource LvWindow}">
    <Window.CommandBindings>
        <CommandBinding Command="Close" Executed="CloseWindow" />
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="Close" />
    </Window.InputBindings>

    <!-- In a window smaller than its content the page scrolls (#558). -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource LvHeaderBar}">
            <TextBlock Text="{Binding Name, StringFormat='Password of {0}'}" Style="{StaticResource LvTitle}" />
        </Border>

        <StackPanel Margin="24">
            <TextBlock Text="The account LazyVM signs in to the VM with. The password is hidden until you choose Show password; closing this window hides it."
                       Style="{StaticResource LvMuted}" TextWrapping="Wrap" Margin="0,0,0,12" />

            <!-- With no credential stored, the note says so and how to store one; Show and Copy are disabled. -->
            <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Margin="0,0,0,12" Focusable="True"
                       Visibility="{Binding HasNote, Converter={StaticResource VisibleWhenTrue}}"
                       AutomationProperties.Name="{Binding Note}" />

            <Label Content="_User name" Target="{Binding ElementName=UserNameBox}" Padding="0" Foreground="{DynamicResource LvInk}" FontWeight="SemiBold" />
            <TextBox x:Name="UserNameBox" Text="{Binding UserName, Mode=OneWay}" IsReadOnly="True" Margin="0,4,0,12"
                     AutomationProperties.Name="User name" />

            <Label Content="Pass_word" Target="{Binding ElementName=PasswordBox}" Padding="0" Foreground="{DynamicResource LvInk}" FontWeight="SemiBold" />
            <!-- Read-only text, so Narrator can read the password a character at a time once shown. It cannot be copied or dragged out:
                 the ordinary clipboard keeps it in its history and syncs it. Copy puts it on the clipboard the safe way. -->
            <TextBox x:Name="PasswordBox" Text="{Binding PasswordText, Mode=OneWay}" IsReadOnly="True" Margin="0,4,0,12" FontFamily="Consolas"
                     DataObject.Copying="BlockCopy" ContextMenuService.IsEnabled="False"
                     AutomationProperties.Name="Password" />

            <WrapPanel>
                <Button Content="{Binding ToggleText}" Command="{Binding ToggleCommand}" Margin="0,0,8,8" MinWidth="120"
                        AutomationProperties.Name="{Binding ToggleName}" />
                <Button Content="_Copy password" Command="{Binding CopyCommand}" Margin="0,0,8,8"
                        AutomationProperties.Name="{Binding Name, StringFormat='Copy the password of {0}'}"
                        AutomationProperties.HelpText="Puts the password on the clipboard without showing it, left out of clipboard history. It is cleared after three minutes, or when LazyVM closes, if it is still there." />
            </WrapPanel>

            <TextBlock Text="{Binding Status}" Style="{StaticResource LvStatus}" Margin="0,8,0,0"
                       Visibility="{Binding HasStatus, Converter={StaticResource VisibleWhenTrue}}"
                       AutomationProperties.Name="{Binding Status}" local:LiveRegion.Announce="True" />
            <ProgressBar Style="{StaticResource LvWorkingBar}" />
        </StackPanel>
    </DockPanel>
    </ScrollViewer>
</Window>
