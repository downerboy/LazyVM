@startuml
!include _style.iuml
title Set up

actor "Host user" as User
actor "Administrator" as Admin
Admin --|> User

rectangle "LazyVM" {
  usecase "Create a VM profile\n<size:10>New-LazyVM</size>" as New
  usecase "Copy another VM's\nsettings and tooling" as Copy
  usecase "Choose the LazyVM folder\n<size:10>Set-LazyVMRoot</size>" as Root
  usecase "Store the guest account\n<size:10>Set-LazyVMCredential</size>" as Cred
  usecase "Generate a password" as GenPwd
}

User --> New
Admin --> Root
Admin --> Cred

Copy ..> New : <<extend>>\n[-From]
GenPwd ..> Cred : <<extend>>\n[password left empty]

@enduml
