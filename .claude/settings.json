{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./Invoke-AnalyzerAndTest.ps1)",
      "Bash(./Invoke-AnalyzerAndTest.ps1 *)",
      "Bash(pwsh -NoProfile -File ./Invoke-AnalyzerAndTest.ps1)",
      "Bash(pwsh -NoProfile -File ./Invoke-AnalyzerAndTest.ps1 *)",
      "PowerShell(./Invoke-AnalyzerAndTest.ps1)",
      "PowerShell(./Invoke-AnalyzerAndTest.ps1 *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(gh issue list *)",
      "PowerShell(gh issue view *)",
      "PowerShell(gh pr list *)",
      "PowerShell(gh pr view *)",
      "PowerShell(gh pr checks *)",
      "PowerShell(gh run list *)",
      "PowerShell(gh run view *)"
    ],
    "deny": [
      "Edit(/src/LazyVM/Data/LazyVM.Config.psd1)",
      "Edit(/src/LazyVM/Data/VMs/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/Invoke-AnalyzerOnEdit.ps1\"",
            "timeout": 60,
            "statusMessage": "Running PSScriptAnalyzer..."
          }
        ]
      }
    ]
  }
}
